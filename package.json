{
  "name": "friendpocalypse",
  "version": "0.1.2",
  "description": "Friendpocalypse — кооператив с друзьями через Steam",
  "author": "Friendpocalypse",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis zip --x64 --publish never",
    "pack:win": "electron-builder --win --x64 --dir"
  },
  "dependencies": { "steamworks-ffi-node": "0.11.3", "electron-updater": "6.8.9" },
  "devDependencies": { "electron": "45.0.0", "electron-builder": "26.15.3" },
  "build": {
    "appId": "games.friendpocalypse.launcher",
    "productName": "Friendpocalypse",
    "directories": { "output": "release" },
    "asarUnpack": ["node_modules/koffi/**", "node_modules/steamworks-ffi-node/**"],
    "files": ["desktop/**", "*.js", "index.html", "assets/**", "audio/**", "fonts/**", "package.json", "!node_modules/steamworks-ffi-node/prebuilds/**"],
    "extraResources": [{ "from": "vendor/steamworks_sdk/redistributable_bin/win64/steam_api64.dll", "to": "steamworks_sdk/redistributable_bin/win64/steam_api64.dll" }],
    "extraFiles": [{ "from": "desktop/steam_appid.txt", "to": "steam_appid.txt" }, { "from": "PLAY.txt", "to": "КАК ИГРАТЬ.txt" }],
    "publish": [{ "provider": "github", "owner": "kavotavochavo1-ctrl", "repo": "friendpocalypse" }],
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "artifactName": "Friendpocalypse-Setup-${version}.exe", "deleteAppDataOnUninstall": false },
    "win": { "target": ["nsis", "zip"], "artifactName": "Friendpocalypse-${version}-Windows-x64.${ext}", "icon": "desktop/icon.ico", "signExecutable": false }
  }
}
